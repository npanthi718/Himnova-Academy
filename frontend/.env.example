# Frontend Public Web App URL (e.g. http://localhost:3000 or https://academy.himnovatech.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend NestJS REST API Gateway (e.g. http://localhost:4000/api/v1 or https://api.himnovatech.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Brand & Corporate Metadata
NEXT_PUBLIC_SITE_NAME="Himnova Academy | Enterprise LMS & AI Career Platform"
NEXT_PUBLIC_COMPANY_NAME="Himnova Technologies Pvt. Ltd."
NEXT_PUBLIC_COMPANY_URL="https://himnovatech.com"
